{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "RISK_REGISTER.schema.json",
  "title": "Risk Register",
  "description": "Stage 3 output. Stage 13 (Coverage Analysis) checks every entry here for a resolved disposition. Nothing may be added after Stage 3 without a recorded reentry event (STATE_MACHINE.md).",
  "type": "object",
  "required": ["cycle_id", "entries"],
  "properties": {
    "cycle_id": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk_id", "risk", "affected_component", "severity",
          "test_required", "disposition"
        ],
        "properties": {
          "risk_id": {"type": "string"},
          "risk": {"type": "string"},
          "affected_component": {"type": "string"},
          "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "test_required": {"type": "boolean"},
          "capability": {"type": "string"},
          "reason": {"type": "string"},
          "disposition": {
            "type": "string",
            "enum": ["PASSED", "FAILED", "BLOCKED", "NOT_APPLICABLE", "DEFERRED", "UNRESOLVED"],
            "description": "UNRESOLVED is only legal before Stage 13 completes. Stage 13's exit condition requires zero UNRESOLVED entries."
          },
          "evidence_pointer": {"type": "string"}
        }
      }
    }
  }
}
